# Repository-relative defaults; override any value from the environment when
# resources are stored elsewhere.
BASE_MODEL="${BASE_MODEL:-$REPO_ROOT/models/Qwen3.5-4B}"
DATA_ROOT="${DATA_ROOT:-$REPO_ROOT/data/qwen35_4b}"
SFT_DATA="${SFT_DATA:-$DATA_ROOT/sft.parquet}"
SFT_REPORT="${SFT_REPORT:-$DATA_ROOT/sft.report.json}"
RL_DATA="${RL_DATA:-$DATA_ROOT/rl.parquet}"
EVAL_DATA="${EVAL_DATA:-$DATA_ROOT/eval.parquet}"
SAFE_DOCIDS="${SAFE_DOCIDS:-$DATA_ROOT/safe_docids.txt}"
CORPUS="${CORPUS:-$REPO_ROOT/data/browsecomp-plus-corpus}"
SEARCH_INDEX="${SEARCH_INDEX:-$REPO_ROOT/data/browsecomp-plus-indexes/qwen3-embedding-8b}"
SEARCH_ENCODER="${SEARCH_ENCODER:-$REPO_ROOT/models/Qwen3-Embedding-8B}"
REASONING_INDEX="${REASONING_INDEX:-$REPO_ROOT/data/agentir/AgentIR_browsecomp-plus}"
REASONING_ENCODER="${REASONING_ENCODER:-$REPO_ROOT/models/AgentIR-4B}"
RUN_ROOT="${RUN_ROOT:-$REPO_ROOT/outputs/qwen35_4b}"
SFT_MODEL="${SFT_MODEL:-$RUN_ROOT/sft/global_step_28/huggingface}"
# Original resource layout: retrieval shares GPUs 0-3 with 8-GPU training.
TRAIN_GPUS="${TRAIN_GPUS:-0,1,2,3,4,5,6,7}"
RETRIEVAL_GPUS="${RETRIEVAL_GPUS:-0,1,2,3}"
EVAL_GPUS="${EVAL_GPUS:-4,5,6,7}"
PRIMARY_PORT="${PRIMARY_PORT:-1249}"
SECONDARY_PORT="${SECONDARY_PORT:-1250}"
EVAL_TAG="${EVAL_TAG:-strict_v1}"
# Conservative eval concurrency; generation temperature remains 0.6, NOT 1.0.
EVAL_WORKERS="${EVAL_WORKERS:-16}"
EVAL_BATCH="${EVAL_BATCH:-32}"

# Raw inputs for the complete data pipeline (no prebuilt training parquet needed).
RAW_SFT_DATA="${RAW_SFT_DATA:-$REPO_ROOT/data/asearcher_searchr1/train.parquet}"
WIKI_CORPUS="${WIKI_CORPUS:-$REPO_ROOT/data/wiki-18.jsonl}"
WIKI_INDEX="${WIKI_INDEX:-$REPO_ROOT/data/e5_Flat.index}"
WIKI_ENCODER="${WIKI_ENCODER:-$REPO_ROOT/models/e5-base-v2}"
TEACHER_MODEL="${TEACHER_MODEL:-$REPO_ROOT/models/Qwen3.5-35B-A3B}"
TEACHER_GPUS="${TEACHER_GPUS:-0,1,2,3,4,5,6,7}"
TEACHER_BASE_PORT="${TEACHER_BASE_PORT:-30000}"
RAW_EVAL_DATA="${RAW_EVAL_DATA:-$REPO_ROOT/data/browsecompplus_searchr1/test.parquet}"
# Complete 830-question decrypted JSONL OR a complete historical evaluation dump.
# Read only by the exclusion firewall, NEVER passed to the QA generator.
BENCHMARK_JSONL="${BENCHMARK_JSONL:-$REPO_ROOT/data/browsecomp-plus/benchmark.jsonl}"
QREL_GOLDS="${QREL_GOLDS:-$REPO_ROOT/data/browsecomp-plus/qrel_golds.txt}"
QREL_EVIDENCE="${QREL_EVIDENCE:-$REPO_ROOT/data/browsecomp-plus/qrel_evidence.txt}"
SFT_ROWS="${SFT_ROWS:-2000}"
# Fixed dates avoid silently changing prompts on a different day.
SFT_DATE="${SFT_DATE:-2026-08-22}"
QA_DATE="${QA_DATE:-2026-09-04}"
EVAL_DATE="${EVAL_DATE:-2026-09-13}"
ROLLOUT_BATCH_ROWS="${ROLLOUT_BATCH_ROWS:-1000}"
QA_DATA="${QA_DATA:-$DATA_ROOT/qa/clean/questions.parquet}"
RL_REPORT="${RL_REPORT:-$DATA_ROOT/rl.report.json}"
# 0: freshly built pools + provenance validation; 1: historical 1807/338-row pools.
FROZEN_DATA="${FROZEN_DATA:-0}"
